    "reconstructable_option_skill_relations",
    "reverse_attack_or_skill_to_card_relation",
    "unobservable_deck_order_flag"
  ],
  "truthfulness_evidence": {
    "resolved_energy_histogram": "current.players[*].active_or_bench[*].energies from engine State.getEnergies/getEnergyInfo",
    "physical_attachment": "energyCards/tools/preEvolution instance tokens plus exact card_parent reconstructed in observation order",
    "attach_option_relations": "official option area/index and inPlayArea/inPlayIndex recomputed to exact owner/zone/slot instances, including duplicate card IDs",
    "event_instance_relations": "official serial pairs recomputed to exact actor-visible instances",
    "static_trigger_subject": "full-engine Trigger.triggerType and Trigger.subject Target fields",
    "runtime_trigger_subject_or_object": "excluded because official actor observation does not expose TriggerInfo.subject/object"
  },
  "consumers": {
    "global": "StateEncoder.global_cat/global_num",
    "card": "StateEncoder.card_cat/card_num plus OfficialPrototypeEncoder.card",
    "resource": "StateEncoder.resource_cat/resource_num plus card prototype",
    "event": "StateEncoder.event_cat/event_num plus role-specific card prototypes, attack prototype, and directional source/target relation projections",
    "option": "OptionEncoder categorical/numeric plus role-specific card/attack prototypes and source/target relations",
    "constraints": "ActionDecoder min_count/max_count legality mask"
  }
}
