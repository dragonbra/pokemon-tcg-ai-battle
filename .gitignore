# RL artifacts: large supervised datasets and checkpoints stay local.
# Run metadata, metrics, evaluation reports, and TensorBoard events are tracked.
rl_runs/dataset/*
!rl_runs/dataset/README.md
rl_runs/checkpoint/*
!rl_runs/checkpoint/README.md
# W&B offline/online staging is local and can be regenerated from canonical JSONL.
rl_runs/wandb/
wandb/
*.egg-info/

# Official card data and Card ID PDFs are local reference downloads only.
# Keep the small README tracked, but do not upload the resource files.
data/official/*
data/replays/*
!data/official/README.md

.DS_Store
.claude/settings.local.json
.claude/worktrees/
.hermes/

# Exported model weights and packaged submissions stay local.
evaluation/arena/candidates/
evaluation/arena/candidates/**/strategy/model.bin
archive/submission/**/strategy/model.bin
archive/submission/dist/*.tar.gz

# Nested runtime assets for 0013+ projects are local and reproducible.
/rl_runs/*/dataset/
/rl_runs/*/versions/*/checkpoint/
/rl_runs/*/versions/*/wandb/
/rl_runs/*/versions/*/tensorboard/
