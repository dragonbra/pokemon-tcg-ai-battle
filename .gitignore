__pycache__/
*.py[cod]
.venv/
venv/
.env
.kaggle/
*.zip
*.7z
*.pkl
*.pt
*.pth
*.safetensors
engine/build/
data/competition/
replays/raw/
logs/

# Arena raw collection and long-running execution state are local artifacts.
# Keep compact reports and selected runnable packages in Git instead.
arena/db/*
!arena/db/
!arena/db/arena.sqlite3
arena/runs/
arena/sources/
!arena/packages/**/policy.pt
!arena/packages/**/model.pt

# RL experiments: keep code/design/reference files tracked, ignore all
# generated datasets, checkpoints, metrics and TensorBoard event files.
rl/runs/
*.egg-info/

# Official card data and Card ID PDFs are local reference downloads only.
# Keep the small README tracked, but do not upload the resource files.
data/official/*
!data/official/README.md

.DS_Store
.claude/settings.local.json
.hermes/
