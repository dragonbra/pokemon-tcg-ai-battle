__pycache__/
*.py[cod]
.venv/
venv/
.env
.kaggle/
*.zip
*.7z
*.pkl
*.pt
!evaluation/arena/opponents/marnies_grimmsnarl_ex_froslass_02/policy.pt
!evaluation/arena/opponents/team_rockets_mewtwo_ex_spidops_01/policy.pt
*.pth
*.safetensors
engine/build/
data/competition/
replays/raw/
# Large expert replay corpora are reproducible from their run manifest and
# must not be committed with source code.
replays/kaggle_yushin_ito_*/
replays/kaggle_top100_exact_deck_*/
logs/
.tmp/

# RL artifacts: large supervised datasets and checkpoints stay local.
# Run metadata, metrics, evaluation reports, and TensorBoard events are tracked.
rl_runs/dataset/*
!rl_runs/dataset/README.md
rl_runs/checkpoint/*
!rl_runs/checkpoint/README.md
# W&B offline/online staging is local and can be regenerated from canonical JSONL.
rl_runs/wandb/
*.egg-info/

# Official card data and Card ID PDFs are local reference downloads only.
# Track the two canonical CSV files and README; ignore the remaining resources.
data/official/*
data/replays/*
!data/official/README.md
!data/official/EN_Card_Data.csv
!data/official/JP_Card_Data.csv

.DS_Store
.claude/settings.local.json
.hermes/

# Exported model weights and packaged submissions stay local.
evaluation/arena/candidates/**/strategy/model.bin
submission/**/strategy/model.bin
submission/dist/*.tar.gz

# Nested runtime assets for 0013+ projects are local and reproducible.
/rl_runs/*/dataset/
/rl_runs/*/versions/*/checkpoint/
/rl_runs/*/versions/*/wandb/
/rl_runs/*/versions/*/tensorboard/
