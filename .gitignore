# Local run products are reproducible but not part of the public source tree.
/runs/

# Per-game evaluation payloads are large, reproducible local evidence. Keep the
# aggregate manifests and rendered HTML reports tracked, but do not upload the
# raw games JSON files.
docs/**/games/*.json
